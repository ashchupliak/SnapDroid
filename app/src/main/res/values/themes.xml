<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Base light theme -->
    <style name="Theme.VisualTestingFramework" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/holo_blue_bright</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@android:color/holo_blue_light</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
        <item name="colorSecondary">@android:color/darker_gray</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@android:color/darker_gray</item>
        <item name="colorOnSecondaryContainer">@android:color/black</item>
        <item name="colorTertiary">@android:color/holo_orange_light</item>
        <item name="colorOnTertiary">@android:color/white</item>
        <item name="colorTertiaryContainer">@android:color/holo_orange_light</item>
        <item name="colorOnTertiaryContainer">@android:color/black</item>
        <item name="colorError">@android:color/holo_red_light</item>
        <item name="colorErrorContainer">@android:color/holo_red_light</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorOnErrorContainer">@android:color/black</item>
        <item name="colorBackground">@android:color/white</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorSurfaceVariant">@android:color/background_light</item>
        <item name="colorOnSurfaceVariant">@android:color/black</item>
        <item name="colorOutline">@android:color/darker_gray</item>
        <item name="colorOutlineVariant">@android:color/darker_gray</item>
        <item name="colorSurfaceInverse">@android:color/black</item>
        <item name="colorOnSurfaceInverse">@android:color/white</item>
        <item name="colorPrimaryInverse">@android:color/holo_blue_bright</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    
    <!-- Dark theme -->
    <style name="Theme.VisualTestingFramework.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/holo_blue_bright</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimaryContainer">@android:color/holo_blue_dark</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>
        <item name="colorSecondary">@android:color/darker_gray</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@android:color/darker_gray</item>
        <item name="colorOnSecondaryContainer">@android:color/white</item>
        <item name="colorTertiary">@android:color/holo_orange_dark</item>
        <item name="colorOnTertiary">@android:color/black</item>
        <item name="colorTertiaryContainer">@android:color/holo_orange_dark</item>
        <item name="colorOnTertiaryContainer">@android:color/white</item>
        <item name="colorError">@android:color/holo_red_dark</item>
        <item name="colorErrorContainer">@android:color/holo_red_dark</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorOnErrorContainer">@android:color/white</item>
        <item name="colorBackground">@android:color/black</item>
        <item name="colorOnBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorSurfaceVariant">@android:color/background_dark</item>
        <item name="colorOnSurfaceVariant">@android:color/white</item>
        <item name="colorOutline">@android:color/darker_gray</item>
        <item name="colorOutlineVariant">@android:color/darker_gray</item>
        <item name="colorSurfaceInverse">@android:color/white</item>
        <item name="colorOnSurfaceInverse">@android:color/black</item>
        <item name="colorPrimaryInverse">@android:color/holo_blue_bright</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
</resources> 